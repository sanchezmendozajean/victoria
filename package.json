{
  "name": "victoria",
  "productName": "Victoria",
  "version": "0.1.0",
  "description": "Editor vectorial de escritorio con la sensación de dibujo de Illustrator",
  "private": true,
  "main": "dist-electron/main/index.js",
  "author": "Victoria",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build": "pnpm build:app && electron-builder",
    "build:win": "pnpm build:app && electron-builder --win nsis portable",
    "build:linux": "pnpm build:app && electron-builder --linux AppImage deb rpm",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . && pnpm typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build:app && playwright test",
    "icons:gen": "node scripts/gen-icons.mjs",
    "icon:app": "node scripts/make-app-icon.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "immer": "^11.1.21",
    "nanoid": "^6.0.2",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@12.11.2"
}
